# ==========================================
# Singapore Halal Directory - Environment Variables
# ==========================================
# Copy this file to .env.local and fill in your actual values
# cp .env.example .env.local
#
# NEVER commit .env.local to version control!
# ==========================================

# ==========================================
# 🔴 CRITICAL - Required for Core Functionality
# ==========================================

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# Required for: Database, authentication, file storage
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your_service_role_key_here

# ------------------------------------------
# Stripe Payment Configuration
# ------------------------------------------
# Get these from: https://dashboard.stripe.com/apikeys
# Required for: Featured listing payments
# IMPORTANT: Use TEST keys for development, LIVE keys for production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx  # or pk_live_xxxxx for production
STRIPE_SECRET_KEY=sk_test_xxxxx                    # or sk_live_xxxxx for production
STRIPE_WEBHOOK_SECRET=whsec_xxxxx                  # From Stripe CLI or webhook settings

# ------------------------------------------
# Site Configuration
# ------------------------------------------
# Your production domain URL (used for redirects, emails, badges)
NEXT_PUBLIC_SITE_URL=https://singaporehalaldir.com
# Alternative app URL (if different from site URL)
NEXT_PUBLIC_APP_URL=https://singaporehalaldir.com

# ==========================================
# 🟡 RECOMMENDED - Enhanced Functionality
# ==========================================

# ------------------------------------------
# Resend Email Service
# ------------------------------------------
# Get from: https://resend.com/api-keys
# Required for: Magic link emails, notifications
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=noreply@singaporehalaldir.com
ADMIN_EMAILS=admin@singaporehalaldir.com,admin2@example.com

# ==========================================
# 🟢 OPTIONAL - Advanced Features
# ==========================================

# ------------------------------------------
# OpenAI API (AI Content Generation)
# ------------------------------------------
# Get from: https://platform.openai.com/api-keys
# Used for: AI-generated descriptions, summaries
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_MODEL=gpt-4-turbo-preview

# ------------------------------------------
# Jina.ai API (Web Scraping)
# ------------------------------------------
# Get from: https://jina.ai/
# Used for: Automated business data extraction
# JINA_API_KEY=jina_xxxxx

# ------------------------------------------
# Firecrawl API (Advanced Web Scraping)
# ------------------------------------------
# Get from: https://firecrawl.dev/
# Used for: JavaScript-heavy website scraping
# FIRECRAWL_API_KEY=fc_xxxxx

# ------------------------------------------
# Cron Job Security (Optional)
# ------------------------------------------
# Generate with: openssl rand -base64 32
# Used for: Securing automated task endpoints
# CRON_SECRET=your_random_secret_here

# ==========================================
# Development Settings (Optional)
# ==========================================

# Node environment
# NODE_ENV=development

# ==========================================
# SETUP INSTRUCTIONS
# ==========================================
#
# 1. CRITICAL SERVICES (Required to launch):
#    - Supabase: Database and auth (5-10 min setup)
#    - Stripe: Payment processing (10 min setup)
#    - Site URL: Your production domain
#    - Resend: Email service (5 min setup) - Highly recommended
#
# 2. OPTIONAL SERVICES (Add as needed):
#    - OpenAI: For AI-powered content
#    - Jina.ai/Firecrawl: For automated imports
#    - Cron Secret: For scheduled tasks
#
# 3. DEPLOYMENT:
#    Netlify CLI example:
#    netlify env:set NEXT_PUBLIC_SUPABASE_URL "your_value"
#    netlify env:set STRIPE_SECRET_KEY "your_value"
#    ... (repeat for all variables)
#
# 4. SECURITY:
#    - Never commit .env.local to git
#    - Use different keys for dev/staging/prod
#    - Keep SECRET and SERVICE_ROLE keys server-side only
#    - Rotate keys if accidentally exposed
#
# For detailed setup instructions, see:
# - API_KEYS_SETUP.md (comprehensive guide)
# - STRIPE_SETUP.md (Stripe-specific)
# ==========================================
