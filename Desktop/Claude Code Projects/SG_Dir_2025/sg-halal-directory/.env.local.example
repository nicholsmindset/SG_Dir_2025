# =============================================================================
# SINGAPORE HALAL DIRECTORY - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://yourdomain.com

# -----------------------------------------------------------------------------
# SUPABASE (Required for Database & Authentication)
# -----------------------------------------------------------------------------
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# STRIPE (Required for Payments)
# -----------------------------------------------------------------------------
# Get these from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Product IDs (create in Stripe Dashboard)
STRIPE_FEATURED_1_MONTH_PRICE_ID=price_your_1_month_price_id
STRIPE_FEATURED_3_MONTH_PRICE_ID=price_your_3_month_price_id
STRIPE_FEATURED_6_MONTH_PRICE_ID=price_your_6_month_price_id

# -----------------------------------------------------------------------------
# RESEND (Email Service - Recommended)
# -----------------------------------------------------------------------------
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# ADMIN SETTINGS
# -----------------------------------------------------------------------------
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@yourdomain.com,owner@yourdomain.com

# -----------------------------------------------------------------------------
# OPTIONAL: GEOCODING SERVICE
# -----------------------------------------------------------------------------
# For address to coordinates conversion
# Options: OneMap Singapore (free), Google Maps Geocoding API
ONEMAP_API_KEY=optional_onemap_key
GOOGLE_MAPS_API_KEY=optional_google_maps_key

# -----------------------------------------------------------------------------
# OPTIONAL: WEB SCRAPING (For automated data import)
# -----------------------------------------------------------------------------
JINA_API_KEY=optional_jina_api_key
FIRECRAWL_API_KEY=optional_firecrawl_api_key

# -----------------------------------------------------------------------------
# OPTIONAL: AI CONTENT GENERATION
# -----------------------------------------------------------------------------
OPENAI_API_KEY=optional_openai_key
OPENAI_MODEL=gpt-4-turbo-preview

# -----------------------------------------------------------------------------
# OPTIONAL: ANALYTICS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id

# -----------------------------------------------------------------------------
# NOTES:
# -----------------------------------------------------------------------------
# 1. Required services for basic functionality: Supabase, Stripe
# 2. Recommended for full functionality: Resend (email)
# 3. Optional services enhance features but aren't required for launch
# 4. See API_KEYS_SETUP.md for detailed setup instructions for each service
# 5. Free tier available for: Supabase, Resend, Jina.ai, Firecrawl
# =============================================================================
